# 복사해서 사용: cp .env.example .env
# .env는 커밋하지 마세요 (.gitignore에 등록되어 있습니다).

# --- PostgreSQL ---
DB_NAME=widgetrag
DB_USERNAME=widgetrag
DB_PASSWORD=변경하세요

# --- 관리자 계정 ---
# 최초 기동 시 이 계정으로 관리자를 1회 생성합니다.
# 비워두면 관리자 계정을 만들지 않습니다(기본 비밀번호를 심어두지 않기 위함).
# 이미 같은 이메일의 계정이 있으면 여기 값을 바꿔도 반영되지 않습니다.
# 운영 중인 계정의 비밀번호는 PATCH /api/members/password 로 변경하세요.
ADMIN_EMAIL=admin@widgetrag.com
ADMIN_PASSWORD=변경하세요

# --- 도메인 / HTTPS (caddy) ---
# caddy가 이 도메인 기준으로 Let's Encrypt 인증서를 자동 발급합니다.
# DNS A 레코드가 이 서버 IP를 가리키고 있어야 합니다.
DOMAIN=localhost

# --- 공개 접근 주소 ---
# 고객사에 배포되는 위젯 설치 코드(widget.js)의 절대 URL 기준이 됩니다.
PUBLIC_BASE_URL=http://localhost

# --- CORS ---
# 관리자/회사 콘솔이 서비스되는 오리진을 쉼표로 구분해 등록합니다.
# 와일드카드(*)는 사용하지 마세요 — 세션 쿠키를 허용하는 구성이라 임의 사이트에
# 로그인 세션이 노출됩니다.
#
# 위젯이 설치되는 고객사 도메인은 여기에 넣지 않아도 됩니다.
# 위젯이 호출하는 /api/chat은 쿠키를 쓰지 않아 모든 오리진에 열려 있습니다.
# (SecurityConfig.widgetChatCorsConfiguration 참고)
CORS_ALLOWED_ORIGINS=http://localhost

# --- 세션 쿠키 ---
# HTTPS를 붙인 뒤에는 SESSION_SECURE=true / SESSION_SAME_SITE=none 으로 변경하세요.
# (위젯이 외부 도메인에서 동작하려면 none + HTTPS가 필요합니다)
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# --- ai-server / llm ---
# GPU가 없는 환경에서 임시로 띄울 때만 cpu (임베딩이 매우 느려집니다)
EMBEDDING_DEVICE=cuda

# Ollama 레지스트리 모델명. 모델 교체 시 여기만 바꾸면 llm/ai-server에 함께 적용됩니다.
OLLAMA_MODEL=exaone3.5:7.8b
