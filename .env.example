# 복사해서 사용: cp .env.example .env
# .env는 커밋하지 마세요 (.gitignore에 등록되어 있습니다).

# --- DB ---
# SQLite 임베디드 DB를 사용하므로 별도 DB 계정/비밀번호가 필요 없습니다.
# DB 파일은 backend 컨테이너의 /data/widgetrag/widgetrag.db (upload-data 볼륨)에 생성됩니다.

# --- 관리자 계정 ---
# 최초 기동 시 이 계정으로 관리자를 1회 생성합니다.
# 비워두면 관리자 계정을 만들지 않습니다(기본 비밀번호를 심어두지 않기 위함).
# 이미 같은 이메일의 계정이 있으면 여기 값을 바꿔도 반영되지 않습니다.
# 운영 중인 계정의 비밀번호는 PATCH /api/members/password 로 변경하세요.
ADMIN_EMAIL=admin@widgetrag.com
ADMIN_PASSWORD=변경하세요

# --- HTTPS ---
# caddy는 이관 검증에 맞춰 구성에서 뺐습니다 (frontend의 nginx가 /api를 프록시).
# HTTPS가 필요하면 CSP 로드밸런서에서 종료하세요 — 그 뒤에는 아래 세션 쿠키 값을 바꿉니다.

# --- 공개 접근 주소 ---
# 고객사에 배포되는 위젯 설치 코드(widget.js)의 절대 URL 기준이 됩니다.
PUBLIC_BASE_URL=http://localhost

# --- CORS ---
# 관리자/회사 콘솔이 서비스되는 오리진을 쉼표로 구분해 등록합니다.
# 와일드카드(*)는 사용하지 마세요 — 세션 쿠키를 허용하는 구성이라 임의 사이트에
# 로그인 세션이 노출됩니다.
#
# 위젯이 설치되는 고객사 도메인은 여기에 넣지 않아도 됩니다.
# 위젯이 호출하는 /api/chat은 쿠키를 쓰지 않아 모든 오리진에 열려 있습니다.
# (SecurityConfig.widgetChatCorsConfiguration 참고)
CORS_ALLOWED_ORIGINS=http://localhost

# --- 세션 쿠키 ---
# HTTPS를 붙인 뒤에는 SESSION_SECURE=true / SESSION_SAME_SITE=none 으로 변경하세요.
# (위젯이 외부 도메인에서 동작하려면 none + HTTPS가 필요합니다)
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# --- ai-server / llm ---
# GPU가 없는 환경에서 임시로 띄울 때만 cpu (임베딩이 매우 느려집니다)
EMBEDDING_DEVICE=cuda

# Ollama 레지스트리 모델명. 모델 교체 시 여기만 바꾸면 llm/ai-server에 함께 적용됩니다.
# 기본 Gemma 3 4B — Gemma는 Google 이용약관 대상(산출물 오픈소스 리스트에 약관 표기).
# EXAONE(exaone3.5:7.8b)은 연구용 라이선스 제약이 있어 실증 산출물 기준으로는 비권장.
OLLAMA_MODEL=gemma3:4b

# 이관 전후 동등성 비교용 결정적 설정. 평소 운영은 0.7 · 빈 값(미지정).
LLM_TEMPERATURE=0.7
LLM_SEED=

# --- 타임존 ---
# 엔티티 시각(LocalDateTime.now)이 JVM 기본 타임존을 따릅니다. 컨테이너 기본은 UTC라
# 명시하지 않으면 Shell 설치형(호스트 타임존)과 기록 시각이 갈립니다.
TZ=Asia/Seoul
